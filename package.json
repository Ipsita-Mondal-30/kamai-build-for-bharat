{
  "name": "kamai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kamai: voice ledger, verifiable credit passport and rain-out insurance for street vendors",
  "scripts": {
    "dev": "node init && next dev -p 3000",
    "build": "node init && next build",
