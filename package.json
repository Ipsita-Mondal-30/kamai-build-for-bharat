    "test:api": "node test-api.ts",
    "test:all": "npm test && npm run test:api"
  },
  "dependencies": {
    "next": "^16.4.6",
    "node-fetch": "^3.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
